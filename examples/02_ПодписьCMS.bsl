// Подпись и проверка данных в формате CMS (CAdES-BES) и RAW.
// Предполагается, что объект «Крипто» создан функцией из 01_Подключение.bsl.

&НаКлиенте
Процедура ПодписатьИПроверить(Знач ПутьКлюча, Знач ПарольКлюча)

	Крипто = Крипто();
	ПроверитьКод(Крипто, Крипто.LoadKeyStore(Крипто.KCST_PKCS12, ПарольКлюча, ПутьКлюча, ""));

	Данные = "Договор №15 от 16.10.2026";

	// --- Вложенная подпись (данные внутри CMS), результат в Base64.
	Подпись = Крипто.SignDataResult("", Крипто.KC_SIGN_CMS + Крипто.KC_OUT_BASE64, Данные, "");
	Если Подпись = "" Тогда
		ВызватьИсключение Крипто.GetLastErrorFull();
	КонецЕсли;

	// --- Проверка: пустая строка при ошибке, иначе — отчёт «Signature N 1 … CMS Verify - OK».
	Отчёт = Крипто.VerifyDataResult("", Крипто.KC_SIGN_CMS + Крипто.KC_IN_BASE64, "", Подпись);
	Если Отчёт = "" Тогда
		Сообщить("Подпись неверна: " + Крипто.GetLastErrorFull());
	Иначе
		Сообщить(Отчёт);
	КонецЕсли;

	// --- То же процедурным стилем: код возврата + выходные параметры (данные, отчёт, сертификат подписанта №1).
	ИсходныеДанные = "";
	Отчёт = "";
	СертификатПодписанта = "";
	Код = Крипто.VerifyData("", Крипто.KC_SIGN_CMS + Крипто.KC_IN_BASE64, "", Подпись,
		ИсходныеДанные, Отчёт, 1, СертификатПодписанта);
	Если Код = 0 Тогда
		Сообщить("Данные из подписи: " + ИсходныеДанные);
		Сообщить("Подписант: " + Крипто.CertificateGetInfo(СертификатПодписанта, Крипто.KC_CERTPROP_SUBJECT_COMMONNAME));
		Сообщить("ИИН: " + Крипто.CertificateGetInfo(СертификатПодписанта, Крипто.KC_CERTPROP_SUBJECT_SERIALNUMBER));
	Иначе
		Сообщить(Крипто.GetErrorName(Код) + ": " + Крипто.GetLastErrorText());
	КонецЕсли;

	// --- Отделённая подпись: данные хранятся отдельно, при проверке передаются явно.
	Откреплённая = Крипто.SignDataResult("", Крипто.KC_SIGN_CMS + Крипто.KC_DETACHED_DATA + Крипто.KC_OUT_BASE64, Данные, "");
	Отчёт = Крипто.VerifyDataResult("", Крипто.KC_SIGN_CMS + Крипто.KC_DETACHED_DATA + Крипто.KC_IN_BASE64, Данные, Откреплённая);
	Сообщить("Отделённая подпись: " + ?(Отчёт <> "", "верна", "неверна"));

	// --- Вторая подпись в тот же CMS (другим ключом: загрузите другой ключ и вызовите повторно).
	// Существующая CMS передаётся четвёртым параметром, флаг KC_IN2_BASE64 — она в Base64.
	// Двойная = Крипто.SignDataResult("", Крипто.KC_SIGN_CMS + Крипто.KC_IN2_BASE64 + Крипто.KC_OUT_BASE64, Данные, Подпись);

	// --- Двоичный результат (DER) приходит значением ДвоичныеДанные и не искажается перекодировкой.
	ДвоичнаяПодпись = Крипто.SignDataResult("", Крипто.KC_SIGN_CMS + Крипто.KC_OUT_DER, Данные, "");
	ДвоичнаяПодпись.Записать("C:\Temp\договор.p7s");

	// --- RAW-подпись (без оболочки CMS), проверка по сертификату загруженного ключа.
	Сырая = Крипто.SignDataResult("", Крипто.KC_SIGN_DRAFT + Крипто.KC_OUT_BASE64, Данные, "");
	Отчёт = Крипто.VerifyDataResult("", Крипто.KC_SIGN_DRAFT + Крипто.KC_IN_BASE64, Данные, Сырая);
	Сообщить("RAW: " + ?(Отчёт <> "", "верна", "неверна"));

КонецПроцедуры
