// Подключение компоненты NEKalkan.
//
// 1. В конфигурации создайте общий макет типа «Двоичные данные» с именем NEKalkanКомпонента и загрузите в него
//    пакет out\NEKalkan_win64.zip (MANIFEST.XML + NEKalkan.dll).
// 2. Подключайте компоненту один раз на сеанс и держите объект «Крипто» в переменной модуля.
//    Режим — «НеИзолированно», платформа 8.3.13 и новее, 64-разрядный клиент (или сервер).

&НаКлиенте
Перем Крипто;

&НаКлиенте
Функция Крипто()

	Если Крипто <> Неопределено Тогда
		Возврат Крипто;
	КонецЕсли;

	Подключена = ПодключитьВнешнююКомпоненту("ОбщийМакет.NEKalkanКомпонента", "NEK",
		ТипВнешнейКомпоненты.Native, ТипПодключенияВнешнейКомпоненты.НеИзолированно);
	Если Не Подключена Тогда
		ВызватьИсключение "Не удалось подключить внешнюю компоненту NEKalkan.";
	КонецЕсли;

	Объект = Новый("AddIn.NEK.NEKalkan");
	ПроверитьКод(Объект, Объект.Init());
	Объект.SetStringEncoding("UTF-8");

	// Доверенные сертификаты НУЦ РК (корневой и промежуточный) нужны для подписи и проверки.
	Объект.X509LoadCertificateFromFile("C:\НУЦ\root_gost_2022.cer", Объект.KC_CERT_CA);
	Объект.X509LoadCertificateFromFile("C:\НУЦ\nca_gost_2022.cer", Объект.KC_CERT_INTERMEDIATE);

	Крипто = Объект;
	Возврат Крипто;

КонецФункции

// Код результата 0 (KCR_OK) — успех, иначе — исключение с подробным описанием.
&НаКлиенте
Процедура ПроверитьКод(Объект, Код)

	Если Код <> 0 Тогда
		ВызватьИсключение Объект.GetLastErrorFull();
	КонецЕсли;

КонецПроцедуры
