// Подпись и проверка XML (XMLDSig).
// Предполагается, что объект «Крипто» создан функцией из 01_Подключение.bsl и ключ уже загружен (LoadKeyStore).

&НаКлиенте
Процедура ПодписатьXML()

	Крипто = Крипто();

	XML = "<?xml version=""1.0"" encoding=""UTF-8""?>"
		+ "<Документ><Реквизиты Id=""d1""><Номер>15</Номер><Дата>2026-10-16</Дата></Реквизиты></Документ>";

	// Подпись всего документа. Порядок параметров как у KalkanCrypt COM:
	// alias, flags, signNodeId, parentSignNode, parentNameSpace, inData, outSign
	ПодписанныйXML = "";
	Код = Крипто.SignXML("", Крипто.KC_XML_INCL_C14N, "", "", "", XML, ПодписанныйXML);
	Если Код <> 0 Тогда
		ВызватьИсключение Крипто.GetLastErrorFull();
	КонецЕсли;

	// Подпись только узла с Id="d1" (ссылка URI="#d1"); подпись вставляется в корень.
	ЧастичноПодписанный = Крипто.SignXMLResult("", Крипто.KC_XML_INCL_C14N, "d1", "", "", XML);

	// Подпись в заданный родительский элемент.
	// В родителя <Подписи> подписанная структура помещается внутрь.
	// ВРодителя = Крипто.SignXMLResult("", 0, "d1", "Подписи", "", XMLсЭлементомПодписи);

	// Проверка. Пустая строка — подпись не принята, причина в GetLastErrorFull().
	Отчёт = Крипто.VerifyXMLResult("", 0, ПодписанныйXML);
	Если Отчёт = "" Тогда
		Сообщить("XML не прошёл проверку: " + Крипто.GetLastErrorFull());
	Иначе
		Сообщить(Отчёт);                       // «Signature N 1 … Signature is OK»
	КонецЕсли;

	// Сведения о подписи без проверки.
	Сообщить("Алгоритм подписи: " + Крипто.GetSigAlgFromXML(ПодписанныйXML));
	СертификатПодписи = Крипто.GetCertFromXML(ПодписанныйXML, 1);       // Base64 DER сертификата подписанта №1
	Сообщить("Серийный номер: " + Крипто.CertificateGetInfo(СертификатПодписи, Крипто.KC_CERTPROP_CERT_SN));

	// XML из файла: передайте ДвоичныеДанные — они разбираются как есть, без перекодировки.
	// Данные = Новый ДвоичныеДанные("C:\Temp\документ.xml");
	// ПодписанныйXML = Крипто.SignXMLResult("", 0, "", "", "", Данные);

КонецПроцедуры
