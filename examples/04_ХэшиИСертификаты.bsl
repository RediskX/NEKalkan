// Хэширование, свойства сертификата, проверка сертификата.
// Предполагается, что объект «Крипто» создан функцией из 01_Подключение.bsl.

&НаКлиенте
Процедура ХэшиИСертификаты(Знач ПутьСертификата)

	Крипто = Крипто();

	// --- Хэш Стрибог-256 в Base64; алгоритм задаётся флагом.
	Хэш = Крипто.HashDataResult("", Крипто.KC_HASH_GOST15_256 + Крипто.KC_OUT_BASE64, "Привет");
	Сообщить("Стрибог-256: " + Хэш);

	// SHA-256 и ГОСТ 34.11-94 — строкой или флагом.
	Сообщить("SHA-256: " + Крипто.HashDataResult("sha256", Крипто.KC_OUT_BASE64, "abc"));
	// Хэш файла без загрузки его в 1С: данные — путь к файлу.
	Сообщить("Стрибог-512 файла: " + Крипто.HashDataResult("", Крипто.KC_HASH_GOST15_512 + Крипто.KC_IN_FILE + Крипто.KC_OUT_BASE64, "C:\Temp\файл.bin"));

	// --- Подпись готового хэша (например, полученного от внешней системы).
	ДвоичныйХэш = Крипто.HashDataResult("", Крипто.KC_HASH_GOST15_512, "данные");     // ДвоичныеДанные, 64 байта
	ПодписьХэша = Крипто.SignHashResult("", Крипто.KC_SIGN_DRAFT + Крипто.KC_OUT_BASE64, ДвоичныйХэш);

	// --- Свойства сертификата (DER, PEM или Base64).
	Сертификат = Новый ДвоичныеДанные(ПутьСертификата);
	Сообщить("Кому выдан: " + Крипто.CertificateGetInfo(Сертификат, Крипто.KC_CERTPROP_SUBJECT_COMMONNAME));
	Сообщить("ИИН/БИН:    " + Крипто.CertificateGetInfo(Сертификат, Крипто.KC_CERTPROP_SUBJECT_SERIALNUMBER));
	Сообщить("Действует до: " + Крипто.CertificateGetInfo(Сертификат, Крипто.KC_CERTPROP_NOTAFTER));
	Сообщить("Издатель:   " + Крипто.CertificateGetInfo(Сертификат, Крипто.KC_CERTPROP_ISSUER_COMMONNAME));

	// --- Проверка сертификата: цепочка до загруженного корня и сроки.
	Отчёт = Крипто.X509ValidateCertificateResult(Сертификат, Крипто.KC_USE_NOTHING, "", 0);
	Если Крипто.GetLastError() = 0 Тогда
		Сообщить("Сертификат действителен");
	Иначе
		Сообщить("Проблема с сертификатом: " + Крипто.GetErrorName(Крипто.GetLastError()));
	КонецЕсли;

	// Отзыв по CRL, скачанному заранее в файл.
	// Отчёт = Крипто.X509ValidateCertificateResult(Сертификат, Крипто.KC_USE_CRL, "C:\Temp\nca_gost_2022.crl", 0);

КонецПроцедуры
